# 统一换行：仓库内一律以 LF 存储，检出也保持 LF（跨平台一致，消除 autocrlf 提示）
* text=auto eol=lf

# 明确按文本处理的项目文件类型
*.md   text eol=lf
*.txt  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf

# Windows 批处理需要 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行/差异处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
